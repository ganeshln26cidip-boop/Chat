      "source": [
        "# 2. While loop\n",
        "\n",
        "A `while` loop repeats while its condition is true. Update the counter so the loop can stop."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "i = 1\n",
        "while i <= 5:\n",
        "    print(i)\n",
        "    i += 1"
      ]
    }
