        "# 6. Running total (accumulator)\n",
        "\n",
        "An accumulator stores a running result. Start at 0 for addition."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "total = 0\n",
        "for i in range(1, 11):\n",
        "    total = total + i\n",
        "print('Total =', total)  # 55"
      ]
    }
